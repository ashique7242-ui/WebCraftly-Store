# ==============================================================================
# WebCraftly Environment Configuration Template (.env.example)
# Copy this file to .env.local (or configure in Hostinger/Vercel Environment Settings)
# DO NOT COMMIT REAL SECRETS TO PUBLIC VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Razorpay Live / Production API Keys
# ------------------------------------------------------------------------------
# Public Key ID (Required on both server and client for checkout initialization)
# Format: rzp_live_xxxxxxxxxxxxxx (or rzp_test_xxxxxxxxxxxxxx for staging)
RAZORPAY_KEY_ID=rzp_live_Thrv1hWKAEAggL
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_Thrv1hWKAEAggL

# Private Key Secret (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured under Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. Firebase Client Authentication (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
